RewriteEngine On
RewriteBase /

# Admin panel pages must always start with the current application bundle.
SetEnvIf Request_URI "^/divan_paneli(?:/|$)" ADMIN_PANEL_ROUTE=1
<IfModule mod_headers.c>
    # Chrome/Safari can retain a broken HTTP/3 alternative route while Firefox
    # continues over HTTP/2. Clear it on documents and every subresource so a
    # cached JS/CSS response cannot keep Safari pinned to the broken route.
    # Hostinger's edge adds an HTTP/3 advertisement after Apache processing.
    # Sending `clear` here is still useful where the origin header wins.
    Header always set Alt-Svc "clear"
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=ADMIN_PANEL_ROUTE
    Header always set Pragma "no-cache" env=ADMIN_PANEL_ROUTE
    Header always set Expires "0" env=ADMIN_PANEL_ROUTE
</IfModule>

# Canonical domain redirect (www -> non-www)
RewriteCond %{HTTP_HOST} ^www\.doktorumol\.com\.tr$ [NC]
RewriteRule ^(.*)$ https://doktorumol.com.tr/$1 [R=301,L]

# Normalize only client-requested duplicate slashes, never internal rewrites.
# Query strings are retained; root // becomes /, not another // redirect.
RewriteCond %{THE_REQUEST} "\s/{2,}([^?\s]*)"
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} "\s/([^?\s]*?)/{2,}([^?\s]*)"
RewriteRule ^ /%1/%2 [R=301,L,NE]

# ============================================
# SITEMAP - Kendi domainimizde GERÇEK dosya olarak sunulur.
# (Google cross-host sitemap yönlendirmelerini yok sayıyor.)
# Dosya build öncesi scripts/generate-sitemap.mjs ile güncellenir.
# ============================================
RewriteRule ^sitemap\.xml$ - [L]

# ============================================
# RSS FEED - For Pinterest, Google News, RSS readers
# Redirects /feed/ and /feed to Supabase edge function
# ============================================
RewriteRule ^feed/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/generate-rss [R=302,L,NE]
RewriteRule ^rss/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/generate-rss [R=302,L,NE]
RewriteRule ^rss\.xml$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/generate-rss [R=302,L,NE]

# Performance Optimizations - Google PageSpeed Fixes
<IfModule mod_deflate.c>
    # Enable compression for text files
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache Control - Efficient Cache Durations
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - 1 year
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/ico "access plus 1 year"
    ExpiresByType image/icon "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts - 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/eot "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # Versioned CSS and JavaScript filenames can be cached permanently
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # HTML must always be revalidated so it cannot reference an old bundle
    ExpiresByType text/html "access plus 0 seconds"
    
    # JSON, XML - 1 day
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
</IfModule>

# Alternative cache headers for servers without mod_expires
<IfModule mod_headers.c>
    # Cache static assets for 1 year
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|svg)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Cache fonts for 1 year
    <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Hashed styles can be cached permanently.
    <FilesMatch "\.css$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Versioned application file (app-<hash>.js): content never changes, so the
    # browser keeps it and hard refresh does not re-download 4+ MB. Old
    # versions stay on the server because deploys never delete files.
    <FilesMatch "^app-[A-Za-z0-9_-]+\.js$">
        Header always set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Stable boot files for prerendered pages point at the current release; never cache.
    <FilesMatch "^boot\.(js|css)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>

    # Don't cache HTML
    # HTML should never be cached aggressively in SPA deployments
    <FilesMatch "\.(html|htm)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# Force MIME types - Critical for PageSpeed
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/css .css
    AddType text/html .html
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType image/webp .webp
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/gif .gif
    
    # Remove .svgz handler if exists
    RemoveType .svgz
</IfModule>

# Force correct Content-Type headers - Prevents MIME type mismatch
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs)$">
        Header always set Content-Type "application/javascript; charset=utf-8"
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>

    <FilesMatch "\.css$">
        Header always set Content-Type "text/css; charset=utf-8"
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>
    
    <FilesMatch "\.json$">
        Header always set Content-Type "application/json; charset=utf-8"
    </FilesMatch>
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
    Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' https: data: blob:; object-src 'none'; base-uri 'self'; frame-src 'self' https:; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Removed incorrect asset preload headers to prevent 404 HTML being served as CSS/JS


# Disable directory browsing
Options -Indexes
# /blog is a routed HTML page, not the generated blog/ storage directory.
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

# Specific URL redirects
RewriteRule ^premium-paket-33-3/?$ /paketler [R=301,L]

# Explicit duplicate-content consolidation (SEO: keep only /blog/* canonical)
RewriteRule ^uzun-sure-cinsel-iliskiye-girmezseniz-ne-olur/?$ /blog/uzun-sure-cinsel-iliskiye-girmezseniz-ne-olur [R=301,L,NE]

# Redirect old doctor URLs to new format
# /uzmanlik-alanlari/doktor/doctor-name -> /specialty/doctor-name
RewriteRule ^uzmanlik-alanlari/doktor/([^/]+)/?$ /$1 [R=301,L]

# Redirect doctor names to specialty-based URLs
RewriteRule ^ayse-dolek-kerbel/?$ /aile-danismani/ayse-dolek-kerbel [R=301,L]

# Eski bozuk branş yazımlı uzman adresleri → doğru adresler (SEO)
RewriteRule ^aile-ve-i-liski-danismani/kubra-simsek/?$ /aile-ve-iliski-danismani/kubra-simsek [R=301,L]
RewriteRule ^evlilik-i-liski-danismani-kisisel-gelisim-uzmani-ve-yonetici-mentor/gulsen-bayram/?$ /evlilikiliski-danismani-kisisel-gelisim-uzmani-ve-yonetici-mentor/gulsen-bayram [R=301,L]
RewriteRule ^aile-i-liski-danismani/aile-elif-yasemin-yuvaci/?$ /aileiliski-danismani/aile-elif-yasemin-yuvaci [R=301,L]

# Türkçe karakterli eski blog adresi → ASCII kanonik adresi
RewriteCond %{THE_REQUEST} \s/blog/hangi-vitamin-eksik%C4%9Fli%C4%9Fi-alerji-yapar[\s?] [NC]
RewriteRule ^ /blog/hangi-vitamin-eksikligi-alerji-yapar [R=301,L]


# Redirect system/campaign pages that should never live under /blog/
RewriteRule ^blog/(partner-giris|partner|ozel-firsat|kayit-linki|bu-aya-ozel|danismanlik-randevusu-al)/?$ /$1 [R=301,L]

# Kopya adresleri tek adreste birleştir (SEO)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^about/?$ /hakkimizda [R=301,L]
RewriteRule ^anasayfa/?$ / [R=301,L]
RewriteRule ^sikca-sorulan-sorular/?$ /sss [R=301,L]
RewriteRule ^privacy/?$ /gizlilik-politikasi [R=301,L]
RewriteRule ^disclosure-text/?$ /aydinlatma-metni [R=301,L]
RewriteRule ^explicit-consent/?$ /acik-riza [R=301,L]
RewriteRule ^distance-sales-contract/?$ /mesafeli-satis-sozlesmesi [R=301,L]
RewriteRule ^Blog/(.*)$ /blog/$1 [R=301,L]
# Retired WordPress categories have a relevant destination, not a profile page.
RewriteRule ^category/(uzman-psikolog|psikolog|klinik-psikolog|aile-danismani)/?$ /uzmanlar [R=301,L]
RewriteRule ^category(?:/.*)?$ /blog [R=301,L]
# Sondaki eğik çizgiyi kaldır (/uzmanlar/ -> /uzmanlar); gerçek klasörlere dokunma
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|assets)/
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Consolidate duplicate legal-page aliases to one canonical URL
RewriteRule ^visitor-consultant-agreement/?$ /ziyaretci-danisan-sozlesmesi [R=301,L]
RewriteRule ^comment-rules/?$ /yorum-kurallari [R=301,L]

# Blog listing page - /blog must stay as /blog (not redirect)
# Blog posts use /blog/slug format - no redirect needed

# 301 redirect old clean blog URLs to canonical /blog/* (SEO: consolidate duplicate URLs)
RewriteCond %{REQUEST_URI} !^/blog/?$
RewriteCond %{REQUEST_URI} !^/blog/
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !^/(about|hakkimizda|iletisim|uzmanlar|uzmanlik|paketler|kampanyali-paket|kampanyali-premium-paket|indirimli-paket|psikolog-paketi|diyetisyen-paketi|fizyoterapist-paketi|aile-danismani-paketi|odeme|odeme-sayfasi|odeme-basarili|privacy|gizlilik-politikasi|disclosure-text|aydinlatma-metni|mesafeli-satis-sozlesmesi|visitor-consultant-agreement|ziyaretci-danisan-sozlesmesi|comment-rules|yorum-kurallari|anasayfa|giris-yap|sifre-sifirla|kayit-ol|test|test-al|test-sonuc|divan_paneli|doktor-paneli|bu-aya-ozel|ozel-firsat|kayit-linki|randevu-sayfasi|randevu-al|sss|sikca-sorulan-sorular|partner|partner-giris|danismanlik-randevusu-al|acik-riza|explicit-consent|distance-sales-contract|uye-ol|danisan-giris|danisan-paneli|kariyer|sesli-asistan|checkout|payment-success|mobile|pre|doki-logos|cagri-merkezi-aydinlatma-metni|kvkk-taslak)
RewriteCond %{REQUEST_URI} !^/randevu-al/
RewriteCond %{REQUEST_URI} !^/yazilar/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Dosya uzantılı adresler (robots.txt, sitemap.xml, .txt doğrulama dosyaları vb.) asla /blog/'a yönlenmez
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
# Never redirect an invented slug (or a temporarily missing robots.txt).
RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
RewriteRule ^([^/]+)/?$ /blog/$1 [R=301,L]

RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
RewriteRule ^yazilar/([A-Za-z0-9_-]+)/?$ /blog/$1 [R=301,L]

# BirFatura API proxy routes (with token passthrough)
# Try proxy first
<IfModule mod_rewrite.c>
  RewriteEngine On
  # orderStatus
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/orderStatus/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-order-status?token=%1 [R=307,L]
  RewriteRule ^api/orderStatus/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-order-status [R=307,L]
  
  # paymentMethods
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/paymentMethods/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-payment-methods?token=%1 [R=307,L]
  RewriteRule ^api/paymentMethods/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-payment-methods [R=307,L]
  
  # orders
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/orders/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-orders?token=%1 [R=307,L]
  RewriteRule ^api/orders/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-orders [R=307,L]
  
  # orderCargoUpdate
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/orderCargoUpdate/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-order-cargo-update?token=%1 [R=307,L]
  RewriteRule ^api/orderCargoUpdate/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-order-cargo-update [R=307,L]
  
  # invoiceLinkUpdate
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/invoiceLinkUpdate/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-invoice-link-update?token=%1 [R=307,L]
  RewriteRule ^api/invoiceLinkUpdate/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-invoice-link-update [R=307,L]
</IfModule>

# Handle React Router (catch all) - En sonda olmalı
# Ön-render edilmiş blog sayfaları (Google için tam içerik)
RewriteCond %{THE_REQUEST} \s/blog\.html
RewriteRule ^blog\.html$ /blog [R=301,L]
RewriteCond %{THE_REQUEST} \s/blog/[^/\s]+\.html
RewriteRule ^blog/([A-Za-z0-9_-]+)\.html$ /blog/$1 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/blog.html -f
RewriteRule ^blog/?$ /blog.html [END]
RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
RewriteRule ^blog/([A-Za-z0-9_-]+)/?$ /blog/$1.html [END]

# Ön-render edilmiş diğer sayfalar (ana sayfa, uzmanlar, branşlar, uzman profilleri, kurumsal)
# /pre/ klasörü doğrudan açılırsa asıl adrese yönlendir (kopya adres olmasın)
RewriteCond %{THE_REQUEST} \s/pre/home\.html
RewriteRule ^pre/home\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/pre/[^\s]+\.html
RewriteRule ^pre/(.+)\.html$ /$1 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/pre/home.html -f
RewriteRule ^$ /pre/home.html [END]
RewriteCond %{DOCUMENT_ROOT}/pre/$1.html -f
RewriteRule ^([a-z0-9-]+(?:/[A-Za-z0-9_-]+)?)$ /pre/$1.html [END]

# Only actual application workflows may use the SPA fallback. Public blog,
# specialty and profile pages must have a generated file above, otherwise 404.
# Preserve registration, payment, panels, native and appointment/test workflows.
RewriteRule ^$ /index.html [END]
RewriteRule ^(?:doki-logos|paketler|kampanyali-paket|kampanyali-premium-paket|indirimli-paket|bu-aya-ozel|ozel-firsat|kayit-linki|odeme-sayfasi|odeme-basarili|checkout|payment-success|randevu-sayfasi|danismanlik-randevusu-al|giris-yap|sifre-sifirla|kayit-ol|sesli-asistan|uye-ol|danisan-giris|danisan-paneli|partner-giris|partner|kariyer|doktor-paneli|cagri-merkezi-aydinlatma-metni|ziyaretci-danisman-sozlesmesi)$ /index.html [END,QSA]
RewriteRule ^(?:odeme|checkout)/[^/]+$ /index.html [END,QSA]
RewriteRule ^(?:divan_paneli|mobile)(?:/.*)?$ /index.html [END,QSA]
RewriteRule ^kvkk-taslak/[^/]+$ /index.html [END,QSA]
RewriteRule ^randevu-al/[^/]+/[^/]+$ /index.html [END,QSA]
RewriteRule ^(?:test|test-al)/[^/]+(?:/[^/]+)?$ /index.html [END,QSA]
RewriteRule ^test-sonuc/[^/]+/[^/]+$ /index.html [END,QSA]
RewriteRule ^[^/]+/[^/]+/(?:uzmani-degerlendir|test/[^/]+)$ /index.html [END,QSA]
# Content created after the last deploy (new blog posts, newly approved
# specialists, new specialty pages) has no generated file yet; let the app
# render it from live data instead of a dead 404 until the next deploy.
RewriteRule ^(?:uzmanlar|blog)$ /index.html [END,QSA]
RewriteRule ^blog/[A-Za-z0-9_-]+$ /index.html [END,QSA]
RewriteRule ^uzmanlik/[a-z0-9-]+$ /index.html [END,QSA]
RewriteRule ^[a-z0-9-]+/[A-Za-z0-9_-]+$ /index.html [END,QSA]

# Serve real files (including robots/sitemap), but never mask a missing asset.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
ErrorDocument 404 /404.html
# ===== Charset (HTTP header) =====
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Content-Type "text/html; charset=UTF-8"
    </FilesMatch>
</IfModule>
