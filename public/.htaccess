RewriteEngine On
RewriteBase /

# Admin panel pages must always start with the current application bundle.
SetEnvIf Request_URI "^/divan_paneli(?:/|$)" ADMIN_PANEL_ROUTE=1
<IfModule mod_headers.c>
    # Chrome/Safari can retain a broken HTTP/3 alternative route while Firefox
    # continues over HTTP/2. Clear it on documents and every subresource so a
    # cached JS/CSS response cannot keep Safari pinned to the broken route.
    Header always set Alt-Svc "clear"
    Header always unset Alt-Svc
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=ADMIN_PANEL_ROUTE
    Header always set Pragma "no-cache" env=ADMIN_PANEL_ROUTE
    Header always set Expires "0" env=ADMIN_PANEL_ROUTE
</IfModule>

# Canonical domain redirect (www -> non-www)
RewriteCond %{HTTP_HOST} ^www\.doktorumol\.com\.tr$ [NC]
RewriteRule ^(.*)$ https://doktorumol.com.tr/$1 [R=301,L]

# ============================================
# SITEMAP - Kendi domainimizde GERÇEK dosya olarak sunulur.
# (Google cross-host sitemap yönlendirmelerini yok sayıyor.)
# Dosya build öncesi scripts/generate-sitemap.mjs ile güncellenir.
# ============================================
RewriteRule ^sitemap\.xml$ - [L]

# ============================================
# RSS FEED - For Pinterest, Google News, RSS readers
# Redirects /feed/ and /feed to Supabase edge function
# ============================================
RewriteRule ^feed/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/generate-rss [R=302,L,NE]
RewriteRule ^rss/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/generate-rss [R=302,L,NE]
RewriteRule ^rss\.xml$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/generate-rss [R=302,L,NE]

# Performance Optimizations - Google PageSpeed Fixes
<IfModule mod_deflate.c>
    # Enable compression for text files
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache Control - Efficient Cache Durations
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - 1 year
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/ico "access plus 1 year"
    ExpiresByType image/icon "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts - 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/eot "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # Versioned CSS and JavaScript filenames can be cached permanently
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # HTML must always be revalidated so it cannot reference an old bundle
    ExpiresByType text/html "access plus 0 seconds"
    
    # JSON, XML - 1 day
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
</IfModule>

# Alternative cache headers for servers without mod_expires
<IfModule mod_headers.c>
    # Cache static assets for 1 year
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|svg)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Cache fonts for 1 year
    <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Vite filenames are content-hashed and safe to cache permanently
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Don't cache HTML
    # HTML should never be cached aggressively in SPA deployments
    <FilesMatch "\.(html|htm)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# Force MIME types - Critical for PageSpeed
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/css .css
    AddType text/html .html
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType image/webp .webp
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/gif .gif
    
    # Remove .svgz handler if exists
    RemoveType .svgz
</IfModule>

# Force correct Content-Type headers - Prevents MIME type mismatch
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs)$">
        Header always set Content-Type "application/javascript; charset=utf-8"
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>

    <FilesMatch "\.css$">
        Header always set Content-Type "text/css; charset=utf-8"
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>
    
    <FilesMatch "\.json$">
        Header always set Content-Type "application/json; charset=utf-8"
    </FilesMatch>
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
    Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' https: data: blob:; object-src 'none'; base-uri 'self'; frame-src 'self' https:; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Removed incorrect asset preload headers to prevent 404 HTML being served as CSS/JS


# Disable directory browsing
Options -Indexes

# Specific URL redirects
RewriteRule ^premium-paket-33-3/?$ /paketler [R=301,L]

# Explicit duplicate-content consolidation (SEO: keep only /blog/* canonical)
RewriteRule ^uzun-sure-cinsel-iliskiye-girmezseniz-ne-olur/?$ /blog/uzun-sure-cinsel-iliskiye-girmezseniz-ne-olur [R=301,L,NE]

# Redirect old doctor URLs to new format
# /uzmanlik-alanlari/doktor/doctor-name -> /specialty/doctor-name
RewriteRule ^uzmanlik-alanlari/doktor/([^/]+)/?$ /$1 [R=301,L]

# Redirect doctor names to specialty-based URLs
RewriteRule ^ayse-dolek-kerbel/?$ /aile-danismani/ayse-dolek-kerbel [R=301,L]

# Redirect system/campaign pages that should never live under /blog/
RewriteRule ^blog/(partner-giris|partner|ozel-firsat|bu-aya-ozel|danismanlik-randevusu-al)/?$ /$1 [R=301,L]

# Consolidate duplicate legal-page aliases to one canonical URL
RewriteRule ^visitor-consultant-agreement/?$ /ziyaretci-danisan-sozlesmesi [R=301,L]
RewriteRule ^comment-rules/?$ /yorum-kurallari [R=301,L]

# Blog listing page - /blog must stay as /blog (not redirect)
# Blog posts use /blog/slug format - no redirect needed

# 301 redirect old clean blog URLs to canonical /blog/* (SEO: consolidate duplicate URLs)
RewriteCond %{REQUEST_URI} !^/blog/?$
RewriteCond %{REQUEST_URI} !^/blog/
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !^/(about|hakkimizda|iletisim|uzmanlar|uzmanlik|paketler|kampanyali-paket|kampanyali-premium-paket|indirimli-paket|psikolog-paketi|diyetisyen-paketi|fizyoterapist-paketi|aile-danismani-paketi|odeme|odeme-sayfasi|odeme-basarili|privacy|gizlilik-politikasi|disclosure-text|aydinlatma-metni|mesafeli-satis-sozlesmesi|visitor-consultant-agreement|ziyaretci-danisan-sozlesmesi|comment-rules|yorum-kurallari|anasayfa|giris-yap|sifre-sifirla|kayit-ol|test|test-al|test-sonuc|divan_paneli|doktor-paneli|bu-aya-ozel|ozel-firsat|randevu-sayfasi|randevu-al|sss|sikca-sorulan-sorular|partner|partner-giris|danismanlik-randevusu-al)
RewriteCond %{REQUEST_URI} !^/randevu-al/
RewriteCond %{REQUEST_URI} !^/yazilar/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|json|xml|webp)$
RewriteRule ^([^/]+)/?$ /blog/$1 [R=301,L]

# BirFatura API proxy routes (with token passthrough)
# Try proxy first
<IfModule mod_rewrite.c>
  RewriteEngine On
  # orderStatus
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/orderStatus/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-order-status?token=%1 [R=307,L]
  RewriteRule ^api/orderStatus/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-order-status [R=307,L]
  
  # paymentMethods
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/paymentMethods/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-payment-methods?token=%1 [R=307,L]
  RewriteRule ^api/paymentMethods/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-payment-methods [R=307,L]
  
  # orders
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/orders/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-orders?token=%1 [R=307,L]
  RewriteRule ^api/orders/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-orders [R=307,L]
  
  # orderCargoUpdate
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/orderCargoUpdate/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-order-cargo-update?token=%1 [R=307,L]
  RewriteRule ^api/orderCargoUpdate/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-order-cargo-update [R=307,L]
  
  # invoiceLinkUpdate
  RewriteCond %{HTTP:token} (.+)
  RewriteRule ^api/invoiceLinkUpdate/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-invoice-link-update?token=%1 [R=307,L]
  RewriteRule ^api/invoiceLinkUpdate/?$ https://irnfwewabogveofwemvg.supabase.co/functions/v1/birfatura-invoice-link-update [R=307,L]
</IfModule>

# Handle React Router (catch all) - En sonda olmalı
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|json|xml|webp)$
RewriteRule ^(.*)$ /index.html [L,QSA]


# ErrorDocument overrides removed to preserve real 404/500 responses
# (prevents missing JS/CSS files from being rewritten to / and breaking hydration)
# ===== Charset (HTTP header) =====
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Content-Type "text/html; charset=UTF-8"
    </FilesMatch>
</IfModule>
